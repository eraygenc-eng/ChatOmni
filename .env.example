# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL connection used when running ChatOmni directly on the host
POSTGRES_URI=postgresql://chatomni_user:your_password@localhost:5432/chatomni

# PostgreSQL password used by Docker Compose
POSTGRES_PASSWORD=your_docker_postgres_password

# Secret used to sign and verify authentication JWT tokens
JWT_SECRET_KEY=your_random_jwt_secret_key